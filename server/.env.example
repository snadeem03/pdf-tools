PORT=3001
NODE_ENV=development

# REQUIRED in production. Generate with: openssl rand -hex 32
# If unset in development, a random one is generated per-process (sessions
# won't survive a restart). If unset in production, the server refuses to start.
JWT_SECRET=

# Origin of the deployed frontend, added to the CORS allow-list in addition to
# the localhost dev origins.
FRONTEND_URL=

UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
